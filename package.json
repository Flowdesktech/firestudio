{
  "name": "firestudio",
  "version": "2.0.1",
  "description": "A powerful open-source GUI client for Firebase Firestore",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:vite\" \"pnpm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env NODE_ENV=development NODE_OPTIONS=--disable-warning=DEP0040 electron .",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx,js,jsx}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:electron": "pnpm run build && electron-builder --publish never",
    "build:win": "pnpm run build && electron-builder --win --publish never",
    "build:win:ci": "pnpm run build && electron-builder --win nsis --publish never",
    "build:mac": "pnpm run build && electron-builder --mac --publish never",
    "build:linux": "pnpm run build && electron-builder --linux --publish never",
    "build:all": "pnpm run build && electron-builder --win --mac --linux",
    "release": "pnpm run build && electron-builder --publish always",
    "release:win": "pnpm run build && electron-builder --win --publish always",
    "release:mac": "pnpm run build && electron-builder --mac --publish always",
    "release:linux": "pnpm run build && electron-builder --linux --publish always",
    "generate-icon": "node scripts/generate-icon.js",
    "ensure-electron": "node scripts/ensure-electron.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "prepare": "husky",
    "postinstall": "node scripts/ensure-electron.js"
  },
  "keywords": [
    "firebase",
    "firestore",
    "firebase-admin",
    "firebase-gui",
    "firestore-gui",
    "firestore-client",
    "firestore-viewer",
    "firestore-browser",
    "firestore-editor",
    "firestore-manager",
    "database-gui",
    "database-client",
    "nosql",
    "nosql-gui",
    "document-database",
    "google-cloud",
    "gcp",
    "electron",
    "electron-app",
    "react",
    "material-ui",
    "mui",
    "desktop-app",
    "cross-platform",
    "data-viewer",
    "json-viewer",
    "query-builder",
    "firefoo",
    "firefoo-alternative"
  ],
  "author": {
    "name": "Flowdesk",
    "email": "contact@flowdesk.tech"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@reduxjs/toolkit": "^2.12.0",
    "dompurify": "^3.4.14",
    "dotenv": "^16.6.1",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.9",
    "firebase-admin": "^14.3.0",
    "highlight.js": "^11.12.0",
    "mime-types": "^2.1.35",
    "node-fetch": "^2.7.0",
    "punycode": "^2.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "browserslist": "^4.28.8",
    "caniuse-lite": "^1.0.30001810",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "build": {
    "appId": "com.flowdesk.firestudio",
    "productName": "Firestudio",
    "copyright": "Copyright © 2025 Flowdesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Firestudio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "Firestudio",
      "uninstallDisplayName": "Firestudio",
      "artifactName": "${productName}-${version}-Windows-Setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Windows-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon-512.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets",
      "category": "Development",
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "Flowdesktech",
      "repo": "firestudio"
    }
  }
}
